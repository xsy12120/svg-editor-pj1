{
  "name": "svg-editor-pj1",
  "version": "0.1.0",
  "private": true,
  "description": "A command-driven SVG editor for the Software Design PJ1 assignment",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
